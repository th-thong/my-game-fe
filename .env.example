# CDN base URL for images
VITE_IMAGE_URL=http://fvbsefw

# API gateway URL
VITE_API_URL=http://localhost:13000/

# Firebase auth mode: true or false
VITE_AUTH_MODE=true

# Nginx runtime port
NGINX_PORT=5173

# Nginx server name
NGINX_SERVER_NAME=localhost

# Firebase config
VITE_API_KEY=
VITE_AUTH_DOMAIN=
VITE_PROJECT_ID=
VITE_STORAGE_BUCKET=
VITE_MSG_SENDER_ID=
VITE_APP_ID=

# Game version for cache busting
VITE_GAME_VERSION=1.0
